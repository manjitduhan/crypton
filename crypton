#!/usr/bin/env bash
set -Eeuo pipefail

# Crypto workspace entry point.
#
# This file owns workspace-wide concerns only:
#   - host dependency installation;
#   - project discovery and dependency ordering;
#   - dispatching commands to src/<project>/compile.sh;
#   - common workspace paths and cleanup.
#
# Project-specific build and runtime behavior belongs beside the project in
# src/<project>/. Its configure.yaml is the single source of truth for that
# project's settings. This keeps adding a project from growing this file.

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
PROJECTS_DIR="${CRYPTON_PROJECTS_DIR:-$SCRIPT_DIR/src}"
CONFIG_FILE="${CRYPTON_CONFIG:-$SCRIPT_DIR/configure.yaml}"
REQUIREMENTS_FILE="${CRYPTON_REQUIREMENTS:-$SCRIPT_DIR/requirements.yaml}"
JOBS="${CRYPTON_JOBS:-$(getconf _NPROCESSORS_ONLN 2>/dev/null || printf '2')}"

die() { printf 'crypton: error: %s\n' "$*" >&2; exit 1; }
info() { printf 'crypton: %s\n' "$*"; }
warn() { printf 'crypton: warning: %s\n' "$*" >&2; }

require_file() {
  [[ -f "$1" ]] || die "file not found: $1"
}

# The repository deliberately uses a small YAML subset so crypton does not
# require yq or PyYAML. The parser is sufficient for scalar values and the
# paths section in the workspace config; project YAML is parsed by the shared
# helper loaded by each project script.
yaml_value() {
  local file=$1 section=$2 key=$3
  awk -v section="$section" -v key="$key" '
    $0 ~ "^" section ":[[:space:]]*$" { in_section=1; next }
    in_section && /^[^ #[:space:]][^:]*:/ { in_section=0 }
    in_section && $0 ~ "^  " key ":[[:space:]]*" {
      sub("^[^:]*:[[:space:]]*", "")
      sub(/[[:space:]]+#.*/, "")
      gsub(/^"|"$/, "")
      print
      exit
    }
  ' "$file"
}

workspace_path() {
  local key=$1 value
  value=$(yaml_value "$CONFIG_FILE" paths "$key")
  [[ -n "$value" ]] || die "paths.$key is missing from $CONFIG_FILE"
  case "$value" in
    /*) printf '%s' "$value" ;;
    *) printf '%s/%s' "$SCRIPT_DIR" "$value" ;;
  esac
}

source_root() { workspace_path sources; }
build_root() { workspace_path build; }
output_root() { workspace_path output; }

project_dir() { printf '%s/%s' "$PROJECTS_DIR" "$1"; }
project_script() { printf '%s/compile.sh' "$(project_dir "$1")"; }
project_config() { printf '%s/configure.yaml' "$(project_dir "$1")"; }

# Project names are discovered from their compile scripts. A new project is
# therefore added by creating src/name/compile.sh and src/name/configure.yaml;
# no central project list needs to be kept in sync.
project_names() {
  local directory
  [[ -d "$PROJECTS_DIR" ]] || return 0
  for directory in "$PROJECTS_DIR"/*; do
    [[ -d "$directory" && -f "$directory/compile.sh" ]] || continue
    basename -- "$directory"
  done | sort
}

project_value() {
  local project=$1 key=$2 file
  file=$(project_config "$project")
  awk -v key="$key" '
    $0 ~ "^" key ":[[:space:]]*" {
      sub("^[^:]*:[[:space:]]*", "")
      sub(/[[:space:]]+#.*/, "")
      gsub(/^"|"$/, "")
      print
      exit
    }
  ' "$file"
}

project_is_known() {
  local project=${1:-}
  [[ "$project" =~ ^[a-zA-Z0-9_-]+$ ]] || return 1
  [[ -f "$(project_script "$project")" && -f "$(project_config "$project")" ]]
}

require_project() {
  local project=${1:-} configured
  [[ -n "$project" ]] || die 'a project name is required'
  project_is_known "$project" || die "unknown project '$project' (run ./crypton list)"
  configured=$(project_value "$project" project)
  [[ "$configured" == "$project" ]] || die "project name mismatch in $(project_config "$project"): expected '$project'"
}

# Pass the workspace paths explicitly to project scripts. This means a caller
# may relocate sources/build/output through the root YAML without project
# scripts having to know how the workspace was launched.
run_project_script() {
  local project=$1 command=$2 script
  shift 2 || true
  require_project "$project"
  script=$(project_script "$project")
  CRYPTON_ROOT="$SCRIPT_DIR" \
  CRYPTON_PROJECT_DIR="$(project_dir "$project")" \
  CRYPTON_PROJECT_NAME="$project" \
  CRYPTON_PROJECT_CONFIG="$(project_config "$project")" \
  CRYPTON_SOURCE_DIR="$(source_root)/$project" \
  CRYPTON_BUILD_DIR="$(build_root)/$project" \
  CRYPTON_OUTPUT_DIR="$(output_root)/$project" \
  CRYPTON_OUTPUT_ROOT="$(output_root)" \
  CRYPTON_JOBS="$JOBS" \
    "$script" "$command" "$@"
}

# Build dependencies before the requested project. Individual project YAML
# files can name one dependency with `depends_on: openssl`; the state map also
# detects dependency cycles instead of recursing forever.
declare -A BUILD_STATE=()
build_project() {
  local project=$1 dependency state
  shift || true
  require_project "$project"
  state=${BUILD_STATE[$project]:-}
  case "$state" in
    visiting) die "circular project dependency involving '$project'" ;;
    done) return 0 ;;
  esac
  BUILD_STATE[$project]=visiting
  dependency=$(project_value "$project" depends_on)
  # YAML commonly represents an intentionally empty dependency as an empty
  # value, None, or null. Treat all of those spellings as no dependency so a
  # project does not accidentally try to build a project literally named
  # "None" or "NULL".
  dependency="${dependency#"${dependency%%[![:space:]]*}"}"
  dependency="${dependency%"${dependency##*[![:space:]]}"}"
  case "${dependency,,}" in
    ''|none|null)
      dependency=''
      ;;
  esac
  if [[ -n "$dependency" ]]; then
    dependency=${dependency//,/ }
    for dependency in $dependency; do
      build_project "$dependency"
    done
  fi
  info "building project: $project"
  run_project_script "$project" build "$@"
  BUILD_STATE[$project]=done
}

build_all() {
  local requested=${1:-all} project
  shift || true
  if [[ "$requested" == all ]]; then
    while IFS= read -r project; do
      [[ -n "$project" ]] || continue
      build_project "$project" "$@"
    done < <(project_names)
    return
  fi
  build_project "$requested" "$@"
}

clean_all() {
  local requested=${1:-all} project
  if [[ "$requested" == all ]]; then
    while IFS= read -r project; do
      [[ -n "$project" ]] || continue
      run_project_script "$project" clean
    done < <(project_names)
    return
  fi
  run_project_script "$requested" clean
}

clean_sources() {
  local requested=all force=0 project argument
  while (( $# > 0 )); do
    argument=$1
    shift
    case "$argument" in
      all) requested=all ;;
      --force) force=1 ;;
      *) requested=$argument ;;
    esac
  done
  if [[ "$requested" == all ]]; then
    while IFS= read -r project; do
      [[ -n "$project" ]] || continue
      if (( force == 1 )); then run_project_script "$project" clean-sources --force; else run_project_script "$project" clean-sources; fi
    done < <(project_names)
    return
  fi
  if (( force == 1 )); then run_project_script "$requested" clean-sources --force; else run_project_script "$requested" clean-sources; fi
}

detect_os() {
  local kernel
  kernel=$(uname -s)
  case "$kernel" in
    Darwin) printf 'macos'; return ;;
    FreeBSD) printf 'freebsd'; return ;;
    Linux) ;;
    *) die "unsupported operating system: $kernel" ;;
  esac

  [[ -r /etc/os-release ]] || die 'Linux host does not provide /etc/os-release'
  # shellcheck disable=SC1091
  . /etc/os-release
  case "${ID:-}" in
    debian|ubuntu|linuxmint|kali|pop|raspbian) printf 'debian' ;;
    fedora|rhel|centos|rocky|almalinux) printf 'fedora' ;;
    arch|manjaro|endeavouros) printf 'arch' ;;
    alpine) printf 'alpine' ;;
    *) die "unsupported Linux distribution: ${ID:-unknown}; add it to requirements.yaml" ;;
  esac
}

host_runner() {
  if (( EUID == 0 )); then
    printf ''
  elif command -v sudo >/dev/null 2>&1; then
    printf 'sudo'
  else
    die 'installing host dependencies requires root or sudo'
  fi
}

install_requirements() {
  require_file "$REQUIREMENTS_FILE"
  local os manager packages runner dry_run=0
  [[ "${1:-}" == --dry-run ]] && dry_run=1
  os=$(detect_os)
  manager=$(awk -v wanted="$os" '
    /^  - os:/ { active=($0 ~ "os:[[:space:]]*" wanted "[[:space:]]*$") }
    active && /^    manager:/ { sub("^[^:]*:[[:space:]]*", ""); gsub(/^"|"$/, ""); print; exit }
  ' "$REQUIREMENTS_FILE")
  packages=$(awk -v wanted="$os" '
    /^  - os:/ { active=($0 ~ "os:[[:space:]]*" wanted "[[:space:]]*$") }
    active && /^    package:/ { sub("^[^:]*:[[:space:]]*", ""); gsub(/^"|"$/, ""); print; exit }
  ' "$REQUIREMENTS_FILE")
  [[ -n "$manager" && -n "$packages" ]] || die "no dependency entry for OS: $os"
  info "detected OS: $os; package manager: $manager"
  if (( dry_run == 1 )); then
    info "would install: $packages"
    return
  fi
  runner=$(host_runner)
  case "$manager" in
    apt-get)
      command -v apt-get >/dev/null || die 'apt-get is not installed'
      [[ -n "$runner" ]] && "$runner" apt-get update
      [[ -n "$runner" ]] && "$runner" apt-get install -y $packages || apt-get install -y $packages
      ;;
    dnf)
      command -v dnf >/dev/null || die 'dnf is not installed'
      [[ -n "$runner" ]] && "$runner" dnf install -y $packages || dnf install -y $packages
      ;;
    pacman)
      command -v pacman >/dev/null || die 'pacman is not installed'
      [[ -n "$runner" ]] && "$runner" pacman -S --needed --noconfirm $packages || pacman -S --needed --noconfirm $packages
      ;;
    apk)
      command -v apk >/dev/null || die 'apk is not installed'
      [[ -n "$runner" ]] && "$runner" apk add $packages || apk add $packages
      ;;
    brew)
      command -v brew >/dev/null || die 'Homebrew is required on macOS: https://brew.sh/'
      brew install $packages
      ;;
    pkg)
      command -v pkg >/dev/null || die 'pkg is not installed'
      [[ -n "$runner" ]] && "$runner" pkg install -y $packages || pkg install -y $packages
      ;;
    *) die "unsupported package manager in requirements.yaml: $manager" ;;
  esac
  info 'host dependencies installed'
}

usage() {
  cat <<'EOF'
Usage: ./crypton <command> [project] [args...]

Commands:
  install [--dry-run]     Install host dependencies for this OS
  build [all|project]     Build one project or all projects (dependencies first)
  clean [all|project]     Remove generated build/output trees
  clean-sources [project] [--force]
                          Remove downloaded source checkouts
  run <project> [args]    Run a project's configured command
  stop <project>          Stop a running project service
  list                    List projects discovered under src/
  help                    Show this help

Configuration:
  configure.yaml          Workspace paths only
  src/<project>/configure.yaml
                          Project source, build, dependency, and runtime settings

Environment:
  CRYPTON_JOBS=N          Number of parallel build jobs (default: CPU count)
  CRYPTON_CONFIG=PATH     Alternate workspace configure.yaml
  CRYPTON_REQUIREMENTS=PATH
                          Alternate requirements.yaml
EOF
}

main() {
  require_file "$CONFIG_FILE"
  local command=${1:-help} project
  shift || true
  case "$command" in
    install) install_requirements "$@" ;;
    build)
      project=${1:-all}
      shift || true
      build_all "$project" "$@"
      ;;
    clean)
      project=${1:-all}
      shift || true
      [[ $# -eq 0 ]] || die 'clean accepts only a project name'
      clean_all "$project"
      ;;
    clean-sources|clean-source) clean_sources "$@" ;;
    run)
      project=${1:-}
      shift || true
      run_project_script "$project" run "$@"
      ;;
    stop)
      project=${1:-}
      shift || true
      run_project_script "$project" stop "$@"
      ;;
    list) project_names ;;
    help|-h|--help) usage ;;
    *) usage >&2; die "unknown command: $command" ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
